{
  "name": "study-journey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 6174",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply study-journey --local",
    "db:migrate:remote": "wrangler d1 migrations apply study-journey --remote",
    "deploy:preview": "npm run build && wrangler versions upload --preview-alias",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.7.11",
    "hono": "^4.13.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.7",
    "wrangler": "^4.151.2"
  }
}
