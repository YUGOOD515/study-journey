# 复制为 .dev.vars 后用于 `npm run dev`（wrangler dev）。不要提交 .dev.vars。
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
TRUSTED_ORIGINS=http://localhost:6173
# Turnstile 官方测试密钥（总是通过）；线上请换成真实 widget 的 key。
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# 可选：配置 Resend 后启用邮箱验证 / 找回密码
# RESEND_API_KEY=re_xxx
# MAIL_FROM=学旅 <no-reply@example.com>
